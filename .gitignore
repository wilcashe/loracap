__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# Study outputs are regenerated by `run.py run <name>` and can be large, so a
# new study's outputs stay out of the repository by default. The three
# reference studies' outputs are committed deliberately: every number the
# README quotes can then be checked against its file without
# re-running an hour of simulation.
studies/*/outputs/
!studies/iot4cows/outputs/
!studies/bor2016_sn1/outputs/
!studies/bor2016_sn3/outputs/
